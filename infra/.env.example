# Meridian core platform env (dev defaults — SPEC 1.3)
EVENT_BUS=inproc                    # inproc | kafka
KAFKA_BROKERS=localhost:9092
KAFKA_PROXY_URL=http://localhost:8082
DATABASE_URL=                       # postgres://meridian:meridian@localhost:5432/meridian (unset = embedded/SQLite fallback)
DATA_DIR=./data
AUTH_MODE=dev                       # dev | prod (prod = Keycloak OIDC JWKS)
MERIDIAN_DEV_JWT_SECRET=meridian-dev-secret-change-me
OIDC_ISSUER_URL=http://localhost:8085/realms/meridian
TIN_HMAC_KEY=meridian-dev-tin-hmac-key
TEMPORAL_URL=                       # localhost:7233 (unset = inproc runner)
TIGERBEETLE_ADDRESSES=              # 3000 (unset = dev in-process ledger client)
OPENSEARCH_URL=                     # http://localhost:9200 (unset = local JSON index)
REDIS_URL=redis://localhost:6379
GEO_RS_URL=                         # http://localhost:8100 (unset = embedded polygons)
RP_REGISTRY_URL=                    # http://localhost:8002
OUTBOX_WATCH_DIR=                   # e.g. ./data (search-indexer cross-service dev indexing)
S3_ENDPOINT=http://localhost:9000
PERMIFY_URL=localhost:3476
APISIX_ADMIN_URL=http://localhost:9180
