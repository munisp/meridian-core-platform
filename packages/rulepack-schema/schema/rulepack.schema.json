{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.nrs/schemas/rulepack.schema.json",
  "title": "Meridian rule-pack (rp-*) pack file",
  "description": "Grammar for rp-* rule pack YAML files per SPEC 1.4. One file per pack version at packs/<pack-id>/<version>.yaml.",
  "type": "object",
  "required": ["id", "version", "effective_from", "status", "subject_to_regazette", "provenance", "rules"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rp-[a-z0-9][a-z0-9-]*$",
      "description": "Pack identifier, e.g. rp-wht-2024"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver, e.g. 1.0.0"
    },
    "effective_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "effective_to": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "simulation", "published", "retired"]
    },
    "subject_to_regazette": {
      "type": "boolean",
      "description": "G1 flag: true until CTCs confirmed"
    },
    "provenance": {
      "type": "object",
      "required": ["as_passed", "as_gazetted", "source_citation"],
      "additionalProperties": false,
      "properties": {
        "as_passed": { "type": "string" },
        "as_gazetted": { "type": ["string", "null"] },
        "source_citation": { "type": "string" }
      }
    },
    "signed": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["ed25519"] },
        "key_id": { "type": "string" },
        "signature": { "type": "string", "pattern": "^[0-9a-f]*$" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "when", "then"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "description": { "type": "string" },
        "when": {
          "type": "object",
          "description": "Match conditions against the evaluation context. Values may be scalars, {op: value} operator objects (eq, neq, gt, gte, lt, lte, in, nin, exists, matches) or arrays (any-of).",
          "additionalProperties": true
        },
        "then": {
          "type": "object",
          "description": "Rule outcome. Exactly one rule kind must be present.",
          "additionalProperties": false,
          "properties": {
            "rate_bps": {
              "type": "integer",
              "minimum": 0,
              "description": "Rate in basis points applied to context.amount"
            },
            "threshold": {
              "type": "object",
              "required": ["field", "op", "value"],
              "additionalProperties": false,
              "properties": {
                "field": { "type": "string" },
                "op": { "type": "string", "enum": ["gt", "gte", "lt", "lte", "eq", "neq"] },
                "value": {},
                "decision_if_true": { "type": "string" },
                "decision_if_false": { "type": "string" }
              }
            },
            "band": {
              "type": "object",
              "required": ["field", "bands"],
              "additionalProperties": false,
              "properties": {
                "field": { "type": "string" },
                "bands": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["min"],
                    "additionalProperties": false,
                    "properties": {
                      "min": { "type": "number" },
                      "max": { "type": ["number", "null"] },
                      "rate_bps": { "type": "integer", "minimum": 0 },
                      "fixed_amount": { "type": "integer" },
                      "label": { "type": "string" }
                    }
                  }
                }
              }
            },
            "formula": {
              "type": "object",
              "required": ["expression", "result_field"],
              "additionalProperties": false,
              "properties": {
                "expression": { "type": "string" },
                "result_field": { "type": "string" },
                "round": { "type": "string", "enum": ["none", "nearest", "up", "down"] }
              }
            },
            "decision_table": {
              "type": "object",
              "required": ["rows"],
              "additionalProperties": false,
              "properties": {
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["match", "output"],
                    "additionalProperties": false,
                    "properties": {
                      "match": { "type": "object" },
                      "output": { "type": "object" }
                    }
                  }
                },
                "default": { "type": ["object", "null"] }
              }
            },
            "decision": { "type": "string" },
            "set": {
              "type": "object",
              "description": "Fields merged into the decision output"
            },
            "narrate": { "type": "string" }
          }
        }
      }
    }
  }
}
