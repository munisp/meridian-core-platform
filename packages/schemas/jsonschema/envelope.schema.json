{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.nrs/schemas/envelope.schema.json",
  "title": "Meridian event envelope (SPEC 1.1)",
  "type": "object",
  "required": ["id", "type", "source", "time", "tenant_id", "trace_id", "rule_pack_version", "data"],
  "properties": {
    "id": {"type": "string", "minLength": 26, "maxLength": 26},
    "type": {"type": "string", "pattern": "^nrs\\.[a-z0-9.]+\\.v\\d+$"},
    "source": {"type": "string"},
    "time": {"type": "string", "format": "date-time"},
    "tenant_id": {"type": "string"},
    "trace_id": {"type": "string", "minLength": 32, "maxLength": 32},
    "rule_pack_version": {"type": "string"},
    "data": {}
  },
  "additionalProperties": false
}
