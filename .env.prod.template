# Meridian .env.prod.template — copy to .env.prod and fill from your secrets
# manager/vault. NEVER commit a filled .env.prod. Every H1 var documented below.

# ---- Platform ---------------------------------------------------------------
# Base domain used for hostnames (admin., gov., compliance., keycloak., ...).
MERIDIAN_DOMAIN=example.gov.ng

# ---- H1: Auth selection ------------------------------------------------------
# dev  = HS256 dev JWT (MERIDIAN_DEV_JWT_SECRET) + X-Dev-Role header.
# keycloak = RS256 OIDC against KEYCLOAK_ISSUER JWKS. Set `keycloak` for prod.
AUTH_MODE=keycloak
# Issuer URL of the meridian realm (must match realm export + KC_HOSTNAME).
KEYCLOAK_ISSUER=https://keycloak.${MERIDIAN_DOMAIN}/realms/meridian
# Expected audience claim on tokens (client-scope meridian-services mapper).
KEYCLOAK_AUDIENCE=meridian-services
# Optional explicit JWKS URL; defaults to {KEYCLOAK_ISSUER}/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL=
# Dev-mode HMAC secret — still required so dev fallback works; rotate freely.
MERIDIAN_DEV_JWT_SECRET=change-me-dev-hmac-secret

# Per-service Keycloak client secrets (client_credentials, realm-meridian.json).
KC_SECRET_RP_REGISTRY=
KC_SECRET_TIN_GRAPH=
KC_SECRET_LEDGER=
KC_SECRET_EINVOICING=
KC_SECRET_ONBOARDING=
KC_SECRET_ENCLAVE_GATEWAY=
KC_SECRET_ADMIN_API=
KC_SECRET_AUDIT_EVIDENCE=

# ---- H1: Storage -------------------------------------------------------------
# Postgres DSN; unset → SQLite at DATA_DIR (dev). Prod: always set.
DATABASE_URL=postgres://meridian:CHANGE@postgres:5432/meridian?sslmode=verify-full
POSTGRES_USER=meridian
POSTGRES_PASSWORD=CHANGE-postgres
POSTGRES_DB=meridian

# ---- H1: Bus (Redpanda/Kafka) ------------------------------------------------
# Comma-separated broker list; unset → embedded inproc bus (dev).
KAFKA_BROKERS=redpanda:9092

# ---- H1: Temporal ------------------------------------------------------------
# host:port of Temporal frontend; unset → inproc runner (dev).
TEMPORAL_URL=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=meridian-core

# ---- H1: TigerBeetle ----------------------------------------------------------
# Comma-separated replica addresses; unset → in-memory ledger (dev).
TIGERBEETLE_ADDRESSES=tigerbeetle:3000

# ---- H1: OpenSearch -----------------------------------------------------------
# https endpoint (security plugin ON in prod profile); unset → local JSON index.
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_ADMIN_PASSWORD=CHANGE-Opensearch-1!

# ---- H1: MinIO WORM evidence store -------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=CHANGE-minio-root
MINIO_ROOT_PASSWORD=CHANGE-minio-secret
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_BUCKET=meridian-evidence
MINIO_USE_SSL=true

# ---- H1: External adapters (leave EMPTY to keep simulators) -------------------
NIMC_API_URL=
NIMC_API_KEY=
PSSP_API_URL=
PSSP_API_KEY=
USSD_AGGREGATOR_URL=
USSD_AGGREGATOR_KEY=

# ---- H1: Service TLS ----------------------------------------------------------
# Optional per-service TLS; unset → plain HTTP behind APISIX (dev).
TLS_CERT_FILE=/tls/service.crt
TLS_KEY_FILE=/tls/service.key

# ---- Middleware internals -----------------------------------------------------
REDIS_PASSWORD=CHANGE-redis
ETCD_ROOT_PASSWORD=CHANGE-etcd
APISIX_ADMIN_KEY=CHANGE-apisix-admin
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=CHANGE-keycloak-admin

# ---- Governance / crypto ------------------------------------------------------
# HMAC key for tin_hash pseudonymisation (SPEC §1.3). 32+ bytes, from vault.
TIN_HMAC_KEY=CHANGE-32-byte-hmac-key
